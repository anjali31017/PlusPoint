<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/png" href="../media/pluspoint_logo.png">
  <title>QuickTake - PlusPoint</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script type="text/javascript"
    src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>

  <style>
    .content-scroll {
      scrollbar-width: thin;
      scrollbar-color: #E9D5FF transparent;
    }

    .content-scroll::-webkit-scrollbar {
      width: 6px;
    }

    .content-scroll::-webkit-scrollbar-thumb {
      background: #E9D5FF;
      border-radius: 10px;
    }

    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }

    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }


 /* Snap Scrolling Logic */
#content-wrapper {
    height: 100vh;
    scroll-snap-type: y mandatory;
    overflow-y: scroll;
    padding: 0 !important; /* Remove padding to go edge-to-edge */
}

.article-reel {
    position: relative;
    height: 100vh;
    width: 100%;
    scroll-snap-align: start;
    display: flex;
    flex-direction: row;
    align-items: flex-end; /* Push content to bottom */
    justify-content: space-between;
    background: linear-gradient(180deg, #1a1a1a 0%, #000 100%); /* Sleek dark theme */
    color: white;
    overflow: hidden;
}

/* Content Area */
.article-content {
    padding: 40px 20px;
    z-index: 2;
    max-width: 80%;
}

.article-content h3 {
    font-size: 1.8rem;
    font-weight: 800;
    margin-bottom: 8px;
    line-height: 1.2;
}

.firm-tag {
    background: rgba(255, 255, 255, 0.2);
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 0.9rem;
    cursor: pointer;
}

/* Sidebar Buttons (Reel Style) */
.reel-buttons {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 20px;
    margin-bottom: 40px;
    align-items: center;
    z-index: 2;
}

.reel-btn-unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
}

.reel-buttons button {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(10px);
    border: none;
    color: white;
    font-size: 1.2rem;
    transition: all 0.2s;
}

.reel-buttons button:active {
    transform: scale(0.9);
}

.btn-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-shadow: 0 2px 4px rgba(0,0,0,0.5);
}

/* Background Decoration (Since no video) */
.reel-bg-gradient {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    opacity: 0.4;
    background: radial-gradient(circle at center, var(--bg-color) 0%, transparent 70%);
}









    
    #google_translate_element .goog-te-gadget a[href*="translate.google.com"] {
      display: none !important;
    }

    .goog-logo-link {
      display: none !important;
    }

    .goog-te-gadget {
      font-size: 0px !important;
    }
  </style>
</head>

<body class="bg-white min-h-screen flex flex-col md:flex-row overflow-hidden font-sans text-gray-900">

  <aside
    class="hidden md:flex flex-col w-72 bg-gradient-to-tr from-blue-100 to-purple-200 h-screen sticky top-0 border-r border-gray-100 z-20">
    <div class="p-5 flex flex-col items-center">
      <h1
        class="text-2xl font-black text-transparent bg-clip-text bg-gradient-to-r from-purple-700 to-blue-600 tracking-tighter">
        PlusPoint</h1>
    </div>
    <nav class="flex-1 overflow-y-auto px-6 py-4 space-y-2 no-scrollbar">
      <div class="space-y-1 mb-8">
        <a href="home.html"
          class="flex items-center space-x-4 px-4 py-3 rounded-2xl text-gray-600 hover:bg-white hover:text-purple-700 transition-all">
          <i data-lucide="home" class="w-5 h-5"></i><span>HOME</span>
        </a>
        <a href="search.html"
          class="flex items-center space-x-4 px-4 py-3 rounded-2xl text-gray-600 hover:bg-white hover:text-purple-700 transition-all">
          <i data-lucide="search" class="w-5 h-5"></i><span>SEARCH</span>
        </a>
        <a href="quickTake.html"
          class="flex items-center space-x-4 px-4 py-3 rounded-2xl bg-purple-50 text-purple-700 font-bold shadow-sm">
          <i data-lucide="compass" class="w-5 h-5"></i><span>QUICK TAKE</span>
        </a>
        <a href="coverage.html"
          class="flex items-center space-x-4 px-4 py-3 rounded-2xl text-gray-600 hover:bg-white hover:text-purple-700 transition-all">
          <i data-lucide="newspaper" class="w-5 h-5"></i><span>COVERAGE</span>
        </a>
        <a href="trending.html"
          class="flex items-center space-x-4 px-4 py-3 rounded-2xl text-gray-600 hover:bg-white hover:text-purple-700 transition-all">
          <i data-lucide="trending-up" class="w-5 h-5"></i><span>TRENDING</span>
        </a>
        <a href="notification.html"
          class="flex items-center space-x-4 px-4 py-3 rounded-2xl text-gray-600 hover:bg-white hover:text-purple-700 transition-all">
          <i data-lucide="rss" class="w-5 h-5"></i><span>NOTIFICATION</span>
        </a>
      </div>
      <div class="pt-6 border-t border-purple-300/30 space-y-1">
        <p class="text-[10px] font-bold text-gray-500 ml-4 mb-2 tracking-[0.2em]">PERSONAL</p>
        <a href="favorites.html"
          class="flex items-center space-x-4 px-4 py-3 rounded-2xl text-gray-600 hover:bg-white hover:text-purple-700 transition-all">
          <i data-lucide="heart" class="w-5 h-5"></i>
          <span>FAVORITES</span>
        </a>
        <a href="profile.html"
          class="flex items-center space-x-4 px-4 py-3 rounded-2xl text-gray-600 hover:bg-white hover:text-purple-700 transition-all">
          <i data-lucide="user" class="w-5 h-5"></i><span>PROFILE</span>
        </a>
        <a href="settings.html"
          class="flex items-center space-x-4 px-4 py-3 rounded-2xl text-gray-600 hover:bg-white hover:text-purple-700 transition-all">
          <i data-lucide="settings" class="w-5 h-5"></i><span>SETTINGS</span>
        </a>
      </div>
    </nav>
  </aside>

  <main class="flex-1 h-screen overflow-y-auto bg-white content-scroll">
    <header
      class="flex justify-between items-center p-6 bg-white/80 backdrop-blur-md sticky top-0 z-10 border-b border-purple-100">
      <h2 class="flex items-center gap-3 text-2xl font-bold text-gray-800">
        <img src="../media/pluspoint_logo.png" alt="PLUSPOINT" class="w-8 h-8">
        QUICK TAKE
      </h2>
      <div class="flex items-center space-x-2 md:space-x-5">
        <div class="px-5 py-2 bg-gray-200" id="google_translate_element"></div>

      </div>
    </header>

    <div id="content-wrapper" class="p-6 md:p-10 max-w-6xl mx-auto pb-32 md:pb-10">


    </div>
  </main>

  <div id="notification-toast-container" class="fixed bottom-4 left-4 z-50 flex flex-col gap-2"></div>

  <script>
    $(document).ready(function () {
      lucide.createIcons();
      $('body').fadeIn(400); // Smoothly show the page
    });
  </script>
  <script src="../scripts/index.js"></script>
  <script src="../scripts/global-notifications.js"></script>
  <script src="../scripts/like.js"></script>
  <script src="../scripts/endorsement.js"></script>
  <script src="../scripts/report.js"></script>
  <script src="../scripts/quicktake-feed.js"></script>
  <script src="../scripts/auth.js"></script>

</body>

</html>