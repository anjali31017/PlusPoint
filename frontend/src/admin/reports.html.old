<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/png" href="../media/pluspoint_logo.png">
  <title>Reports - ADMIN</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>

<body class="bg-gray-100 min-h-screen">
  <!-- NAVIGATION BAR -->
  <nav class="bg-white shadow-md">
    <div class="max-w-6xl mx-auto px-6 py-4 flex justify-between items-center">
      <div class="flex items-center space-x-2">
        <span class="text-2xl font-bold text-rose-600">PlusPoint Admin</span>
      </div>
      <div class="flex items-center space-x-6">
        <a href="kyc.html" class="text-gray-700 font-semibold hover:text-pink-600">KYC</a>
        <a href="#" id="reportLink" class="text-gray-700 font-semibold hover:text-pink-600">Reports</a>
        <button id="logoutBtn"
          class="bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded font-semibold">Logout</button>
      </div>
    </div>
  </nav>

  <div class="max-w-6xl mx-auto p-6">
    <h1 class="text-3xl font-bold mb-6 text-center">Reports Dashboard</h1>

    <!-- Search -->
    <div class="flex justify-center mb-6 gap-2">
      <input type="text" id="searchInput"
        class="border px-4 py-2 rounded w-80" placeholder="Enter Firm ID or Article ID">
      <button id="searchBtn"
        class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded font-semibold">Search</button>
      <button id="clearBtn"
        class="bg-gray-300 hover:bg-gray-400 text-black px-4 py-2 rounded font-semibold">Clear</button>
    </div>

    <!-- Reports Container -->
    <div id="reportsContainer" class="space-y-6"></div>
  </div>

  <script>
    $(document).ready(function () {

      // Load all reports initially
      loadReports();

      // Logout button
      $("#logoutBtn").click(function () {
        $.ajax({
          url: "http://127.0.0.1:5000/api/admin/logout",
          method: "POST",
          xhrFields: { withCredentials: true },
          success: function (res) {
            if (res.status === 1) window.location.href = "login.html";
          }
        });
      });

      // Reports link reloads page
      $("#reportLink").click(function () {
        loadReports();
      });

      // Search functionality
      $("#searchBtn").click(function () {
        const val = $("#searchInput").val().trim();
        if (!val) {
          Swal.fire({ icon: "warning", title: "Enter an ID to search" });
          return;
        }
        loadReports(val);
      });

      // Clear search
      $("#clearBtn").click(function () {
        $("#searchInput").val('');
        loadReports();
      });

    });

    // Load reports
    function loadReports(searchId = '') {
      $("#reportsContainer").html('<p class="text-center text-gray-500">Loading...</p>');

      $.ajax({
        url: "http://127.0.0.1:5000/api/admin/reports",
        method: "GET",
        xhrFields: { withCredentials: true },
        success: function (res) {
          const { firms, articles } = res.data;

          let filteredFirms = firms;
          let filteredArticles = articles;

          if (searchId) {
            // Filter by ID (exact match)
            filteredFirms = firms.filter(f => f.id === searchId);
            filteredArticles = articles.filter(a => a.id === searchId);
          }

          renderReports(filteredFirms, filteredArticles);
        },
        error: function (xhr) {
          Swal.fire({ icon: "error", title: "Failed to load reports" });
        }
      });
    }

    // Render reports cards
    function renderReports(firms, articles) {
      const container = $("#reportsContainer");
      container.empty();

      if (firms.length === 0 && articles.length === 0) {
        container.html("<p class='text-center text-gray-600'>No reports found</p>");
        return;
      }

      // Firms
      firms.forEach(firm => {
        const card = $(`
          <div class="bg-white rounded-xl shadow-md p-6 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
            <div class="flex-1">
              <p><strong>Firm Name:</strong> ${firm.name}</p>
              <p><strong>Firm ID:</strong> ${firm.id}</p>
              <p><strong>Total Reports:</strong> ${firm.report_count}</p>
            </div>
            <div class="flex flex-col gap-2">
              <textarea placeholder="Reason for deletion" class="border px-3 py-2 rounded reasonInput"></textarea>
              <div class="flex gap-2 mt-2">
                <button class="deleteBtn bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded font-semibold">Delete Firm</button>
                <button class="viewReportsBtn bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded font-semibold">View Reports</button>
              </div>
              <div class="mt-2 reportDetails hidden"></div>
            </div>
          </div>
        `);

        // Delete action
        card.find(".deleteBtn").click(function () {
          const reason = card.find(".reasonInput").val().trim();
          if (!reason) {
            Swal.fire({ icon: "warning", title: "Please provide a reason" });
            return;
          }

          Swal.fire({
            title: "Confirm Delete Firm?",
            input: 'text',
            inputLabel: 'Reason',
            inputValue: reason,
            showCancelButton: true,
            confirmButtonText: "Delete",
          }).then(result => {
            if (result.isConfirmed) {
              $.ajax({
                url: `http://127.0.0.1:5000/api/admin/delete/action?firm_id=${firm.id}`,
                method: "POST",
                contentType: "application/json",
                data: JSON.stringify({ reason: result.value }),
                xhrFields: { withCredentials: true },
                success: function () {
                  Swal.fire({ icon: "success", title: "Firm deleted" });
                  loadReports();
                },
                error: function () {
                  Swal.fire({ icon: "error", title: "Failed to delete" });
                }
              });
            }
          });
        });

        // View reports
        card.find(".viewReportsBtn").click(function () {
          $.ajax({
            url: `http://127.0.0.1:5000/api/admin/user-reports?firm_id=${firm.id}`,
            method: "GET",
            xhrFields: { withCredentials: true },
            success: function (res) {
              const reportsDiv = card.find(".reportDetails");
              reportsDiv.empty().removeClass("hidden");
              if (res.data.reports.length === 0) {
                reportsDiv.html("<p>No reports found for this firm</p>");
              } else {
                res.data.reports.forEach(r => {
                  reportsDiv.append(`
                    <div class="border p-2 rounded mb-2">
                      <p><strong>Reported By:</strong> ${r.user_id.email || 'N/A'}</p>
                      <p><strong>Reason:</strong> ${r.reason}</p>
                      <p><strong>Created At:</strong> ${new Date(r.created_at).toLocaleString()}</p>
                    </div>
                  `);
                });
              }
            }
          });
        });

        container.append(card);
      });

      // Articles
      articles.forEach(article => {
        const card = $(`
          <div class="bg-white rounded-xl shadow-md p-6 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
            <div class="flex-1">
              <p><strong>Article Title:</strong> ${article.title}</p>
              <p><strong>Article ID:</strong> ${article.id}</p>
              <p><strong>Total Reports:</strong> ${article.report_count}</p>
            </div>
            <div class="flex flex-col gap-2">
              <textarea placeholder="Reason for deletion" class="border px-3 py-2 rounded reasonInput"></textarea>
              <div class="flex gap-2 mt-2">
                <button class="deleteBtn bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded font-semibold">Delete Article</button>
                <button class="viewReportsBtn bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded font-semibold">View Reports</button>
              </div>
              <div class="mt-2 reportDetails hidden"></div>
            </div>
          </div>
        `);

        // Delete action
        card.find(".deleteBtn").click(function () {
          const reason = card.find(".reasonInput").val().trim();
          if (!reason) {
            Swal.fire({ icon: "warning", title: "Please provide a reason" });
            return;
          }

          Swal.fire({
            title: "Confirm Delete Article?",
            input: 'text',
            inputLabel: 'Reason',
            inputValue: reason,
            showCancelButton: true,
            confirmButtonText: "Delete",
          }).then(result => {
            if (result.isConfirmed) {
              $.ajax({
                url: `http://127.0.0.1:5000/api/admin/delete/action?article_id=${article.id}`,
                method: "POST",
                contentType: "application/json",
                data: JSON.stringify({ reason: result.value }),
                xhrFields: { withCredentials: true },
                success: function () {
                  Swal.fire({ icon: "success", title: "Article deleted" });
                  loadReports();
                },
                error: function () {
                  Swal.fire({ icon: "error", title: "Failed to delete" });
                }
              });
            }
          });
        });

        // View reports
        card.find(".viewReportsBtn").click(function () {
          $.ajax({
            url: `http://127.0.0.1:5000/api/admin/user-reports?article_id=${article.id}`,
            method: "GET",
            xhrFields: { withCredentials: true },
            success: function (res) {
              const reportsDiv = card.find(".reportDetails");
              reportsDiv.empty().removeClass("hidden");
              if (res.data.reports.length === 0) {
                reportsDiv.html("<p>No reports found for this article</p>");
              } else {
                res.data.reports.forEach(r => {
                  reportsDiv.append(`
                    <div class="border p-2 rounded mb-2">
                      <p><strong>Reported By:</strong> ${r.user_id.email || 'N/A'}</p>
                      <p><strong>Reason:</strong> ${r.reason}</p>
                      <p><strong>Created At:</strong> ${new Date(r.created_at).toLocaleString()}</p>
                    </div>
                  `);
                });
              }
            }
          });
        });

        container.append(card);
      });
    }
  </script>

</body>

</html>
